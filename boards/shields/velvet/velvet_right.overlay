/ {
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        gpio-row-ports = <&gpio0 29 GPIO_ACTIVE_HIGH>,
                         <&gpio0 30 GPIO_ACTIVE_HIGH>;
        gpio-col-ports = <&gpio0 31 GPIO_ACTIVE_HIGH>,
                         <&gpio0 28 GPIO_ACTIVE_HIGH>;
    };
};
